{
  "expo": {
    "name": "TrendLab",
    "slug": "trendlab",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O TrendLab precisa acessar sua galeria para definir sua foto de perfil ou usar o Provador Virtual.",
          "cameraPermission": "O TrendLab precisa acessar sua câmera para capturar fotos no Provador Virtual e no seu perfil."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O TrendLab utiliza sua localização para preencher automaticamente seu endereço de entrega no checkout.",
          "locationWhenInUsePermission": "O TrendLab utiliza sua localização para preencher automaticamente seu endereço de entrega no checkout."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "dc60684e-e7a9-45ac-8f17-dd179b62799c"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/dc60684e-e7a9-45ac-8f17-dd179b62799c"
    }
  }
}
