{
  "expo": {
    "name": "TrendLab",
    "slug": "trendlab",
    "version": "1.0.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.vyfahde.trendlab",
      "adaptiveIcon": {
        "backgroundColor": "#22164D",
        "foregroundImage": "./assets/branding/android-foreground.png",
        "monochromeImage": "./assets/branding/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      ["expo-secure-store", { "faceIDPermission": false }],
      [
        "expo-image-picker",
        {
          "photosPermission": "O TrendLab usa a galeria para selecionar sua foto de perfil.",
          "cameraPermission": "O TrendLab usa a câmera para tirar sua foto de perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O TrendLab utiliza sua localização para preencher automaticamente seu endereço de entrega no checkout."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "dc60684e-e7a9-45ac-8f17-dd179b62799c"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/dc60684e-e7a9-45ac-8f17-dd179b62799c"
    }
  }
}
